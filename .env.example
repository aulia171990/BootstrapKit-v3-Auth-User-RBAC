APP_ENV=local
APP_KEY=
JWT_SECRET=change_me_in_production_at_least_32_bytes_long
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Auth hardening
# MAX_FAILED_ATTEMPTS and LOCKOUT_MINUTES are defined on App\Models\User.
# For SMTP-based email verification / password-reset delivery, configure mail:
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@ojol.test
# MAIL_FROM_NAME="Ojol Online"
